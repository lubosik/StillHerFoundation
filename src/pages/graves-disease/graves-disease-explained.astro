---
/**
 * Article: Graves' disease, explained.
 * Route: /graves-disease/graves-disease-explained
 *
 * A single column article. Prose runs straight down in one readable measure,
 * images sit full width between chapters, and citations sit under the
 * paragraph they belong to. The earlier three column layout put the heading,
 * the text and the image side by side, which squeezed the prose into a narrow
 * ribbon and stranded it in a wide page. This replaces it.
 *
 * Three rules this article keeps:
 *   1. Graves' disease is a CAUSE of hyperthyroidism, not a synonym for it.
 *   2. Treatments are described, never recommended.
 *   3. Where authorities disagree, say so and give the range.
 *
 * The full research pack, including the sources that could not be reached and
 * the claims deliberately excluded, is in reference/GRAVES_RESEARCH.md.
 *
 * Nani's account of a flare is her own words about her own body, approved by
 * the client on 16 September. It is not clinical information.
 */
import Base from '@/layouts/Base.astro';
import Picture from '@/components/Picture.astro';
import Newsletter from '@/components/Newsletter.astro';
import { articles } from '@/config/resources';

const article = articles.find((a) => a.slug === 'graves-disease-explained')!;

/** A named source behind a claim. Every citation on the page is one of these. */
const SRC = {
  nhs: { name: 'NHS', href: 'https://www.nhs.uk/conditions/overactive-thyroid-hyperthyroidism/' },
  nhsSymptoms: { name: 'NHS', href: 'https://www.nhs.uk/conditions/overactive-thyroid-hyperthyroidism/symptoms/' },
  nhsDiagnosis: { name: 'NHS', href: 'https://www.nhs.uk/conditions/overactive-thyroid-hyperthyroidism/diagnosis/' },
  nhsTreatment: { name: 'NHS', href: 'https://www.nhs.uk/conditions/overactive-thyroid-hyperthyroidism/treatment/' },
  nhsComplications: { name: 'NHS', href: 'https://www.nhs.uk/conditions/overactive-thyroid-hyperthyroidism/complications/' },
  niddk: { name: 'NIDDK, US National Institutes of Health', href: 'https://www.niddk.nih.gov/health-information/endocrine-diseases/graves-disease' },
  ata: { name: 'American Thyroid Association', href: 'https://www.thyroid.org/graves-disease/' },
  ataEye: { name: 'American Thyroid Association', href: 'https://www.thyroid.org/thyroid-eye-disease/' },
  btf: { name: 'British Thyroid Foundation', href: 'https://www.btf-thyroid.org/hyperthyroidism-leaflet' },
  btfEye: { name: 'British Thyroid Foundation', href: 'https://www.btf-thyroid.org/thyroid-eye-disease-leaflet' },
  btfMind: { name: 'British Thyroid Foundation', href: 'https://www.btf-thyroid.org/psychological-symptoms-and-thyroid-disorders' },
  cleveland: { name: 'Cleveland Clinic', href: 'https://my.clevelandclinic.org/health/diseases/15244-graves-disease' },
  medline: { name: 'MedlinePlus Genetics, US National Library of Medicine', href: 'https://medlineplus.gov/genetics/condition/graves-disease/' },
  cuh: { name: 'Cambridge University Hospitals NHS Foundation Trust', href: 'https://www.cuh.nhs.uk/patient-information/hyperthyroidism-due-to-graves-disease/' },
} as const;

type Src = { name: string; href: string };

/** The chapters. Each paragraph carries the source it came from. */
const sections = [
  {
    id: 'what-it-is',
    number: '01',
    title: "What is Graves' disease?",
    image: 'graves-body',
    imageAlt: 'Soft daylight falling across a cupped hand.',
    paras: [
      { text: 'The thyroid is a small gland in the lower neck, shaped a little like a butterfly. It makes hormones that control how your body uses energy, which is why it affects your heart rate, your weight, your temperature, your digestion and your mood.', src: [SRC.medline, SRC.ata] },
      { text: "Graves' disease is an autoimmune condition. That means the body's own immune system turns against the thyroid gland, and the thyroid responds by becoming overactive.", src: [SRC.btf] },
      { text: 'The immune system makes antibodies that attach to thyroid cells and tell them to produce too much hormone. They are called thyrotropin receptor antibodies, or TRAb. They work by imitating the signal the body normally uses to tell the thyroid what to do.', src: [SRC.ata, SRC.niddk] },
      { text: "This is the part people most often get wrong. Graves' disease is not another name for an overactive thyroid. An overactive thyroid, also called hyperthyroidism, has several causes. Graves' disease is the most common one. About 4 in every 5 people with an overactive thyroid have Graves' disease.", src: [SRC.nhs, SRC.niddk] },
    ],
  },
  {
    id: 'how-it-shows-up',
    number: '02',
    title: 'What are the effects?',
    image: 'graves-symptoms',
    imageAlt: 'An empty linen bed in late afternoon light, shutters half closed.',
    paras: [
      { text: 'Symptoms can come on gradually over months, or suddenly over days. It is unlikely that any one person will have all of them, and no two people look the same.', src: [SRC.nhsSymptoms, SRC.cleveland] },
      { text: 'The NHS lists nervousness, anxiety, irritability, mood swings, difficulty sleeping, tiredness, sensitivity to heat, muscle weakness, needing to pass urine more often, persistent thirst, itchiness and loss of interest in sex.', src: [SRC.nhsSymptoms] },
      { text: 'Physical signs can include a swelling in the neck from an enlarged thyroid, an irregular or fast heartbeat, trembling, warm skin and heavy sweating, hair thinning, and weight loss despite eating more than usual.', src: [SRC.nhsSymptoms] },
      { text: 'Some of it is less expected. Periods can become lighter, less frequent or stop. Breathlessness is common. So is a change in mood: anxiety, low mood, tearfulness and a short temper are all recognised, and they are symptoms, not character.', src: [SRC.cleveland, SRC.btfMind] },
    ],
    callout: {
      title: 'It can affect the eyes',
      paras: [
        { text: "Thyroid eye disease, also called Graves' ophthalmopathy, is a recognised part of the condition. The tissues around the eye become inflamed. Eyes can feel dry and gritty, water, become sensitive to light, or look more prominent. Vision can blur or double.", src: [SRC.btfEye, SRC.nhsComplications] },
        { text: 'How often it happens depends on who you ask. The NHS says around 1 in 4 people with Graves’ disease. The American Thyroid Association and Cleveland Clinic say about a third. The British Thyroid Foundation’s eye leaflet says about 40 percent. What they agree on is that most cases are mild and improve, and that only around 5 percent become moderate or severe.', src: [SRC.nhsComplications, SRC.ata, SRC.btfEye] },
        { text: 'It does not always arrive in step with the thyroid. Eye symptoms commonly appear around six months before or after the thyroid diagnosis, and can begin after treatment has started.', src: [SRC.ata, SRC.btfEye] },
      ],
    },
  },
  {
    id: 'who-it-affects',
    number: '03',
    title: 'Who does it affect?',
    image: 'graves-living',
    imageAlt: 'A figure at a window looking out onto a warm Mediterranean morning.',
    paras: [
      { text: 'It is far more common in women. The American Thyroid Association puts it at 7 to 8 times more common in women than in men.', src: [SRC.ata] },
      { text: 'Estimates of how many people have it vary between authorities. NIDDK says nearly 1 in 100 Americans. MedlinePlus Genetics says about 1 in 200 people. Both are US National Institutes of Health sources. We have not found a published UK figure for Graves’ disease specifically.', src: [SRC.niddk, SRC.medline] },
      { text: 'It is more common in people over 30, and it tends to run in families. A family history of Graves’ disease or of Hashimoto’s disease raises the chance of it, as does having another autoimmune condition such as type 1 diabetes, rheumatoid arthritis or vitiligo.', src: [SRC.niddk, SRC.btf] },
      { text: 'Smoking matters more than most people realise. It raises the chance of developing Graves’ disease, and smokers are up to eight times more likely to develop thyroid eye disease than non smokers.', src: [SRC.niddk, SRC.btf] },
      { text: 'Stress is harder to pin down. The British Thyroid Foundation says it appears to play a role, and some people report a major stress in the year before diagnosis. The NHS and NIDDK do not list it. We mention it because people ask, not because it is settled.', src: [SRC.btf, SRC.cleveland] },
    ],
  },
  {
    id: 'getting-diagnosed',
    number: '04',
    title: 'How is it diagnosed?',
    image: 'graves-diagnosis',
    imageAlt: 'A glass of water, a folded paper and a pen on a table in window light.',
    paras: [
      { text: 'It usually starts with a blood test that a GP can order, alongside your symptoms. The test measures TSH, the hormone the pituitary gland uses to signal the thyroid, and T3 and T4, the two main thyroid hormones.', src: [SRC.nhsDiagnosis] },
      { text: 'A low TSH with high T3 or T4 usually means the thyroid is overactive. That says nothing yet about why.', src: [SRC.nhsDiagnosis] },
      { text: "What confirms Graves' disease specifically is an antibody test, the TSH receptor antibody test. A positive result confirms the diagnosis without further testing.", src: [SRC.nhsDiagnosis, SRC.ata] },
      { text: 'Sometimes more is done: a thyroid uptake scan, or an ultrasound that measures blood flow through the gland. The British Thyroid Foundation notes that scans are only rarely needed.', src: [SRC.niddk, SRC.btf] },
    ],
  },
  {
    id: 'treatment',
    number: '05',
    title: 'What does treatment look like?',
    image: null,
    imageAlt: '',
    intro: 'This section describes what exists. It is not a recommendation, and nothing here should be read as advice about your own care. Which treatment suits a person is a decision made with their doctor. Cleveland Clinic notes plainly that there is no agreement in the medical community on which treatment is best.',
    introSrc: [SRC.cleveland],
    paras: [
      { text: 'Antithyroid medicine stops the thyroid producing excess hormone. In the UK the main ones are carbimazole and propylthiouracil; in the US, methimazole. People usually take them for 12 to 18 months, and it can be a few months before any benefit is felt. The British Thyroid Foundation puts the chance of a lasting cure after a course of tablets at roughly 30 to 50 percent.', src: [SRC.nhsTreatment, SRC.ata, SRC.btf] },
      { text: 'Beta blockers are sometimes given alongside, to settle a fast heartbeat, tremor and nervousness while the main treatment takes effect. They do not change what the thyroid is doing.', src: [SRC.nhsTreatment, SRC.niddk] },
      { text: 'Radioactive iodine is taken as a drink or a capsule. The thyroid absorbs it and it reduces the gland’s ability to make hormone. Almost everyone who has it later develops an underactive thyroid, which is then managed with daily hormone tablets. There are precautions afterwards about close contact and about pregnancy.', src: [SRC.nhsTreatment, SRC.niddk] },
      { text: 'Surgery removes all or part of the thyroid. Afterwards the body cannot make thyroid hormone, so daily medicine such as levothyroxine is needed for life.', src: [SRC.nhsTreatment, SRC.cleveland] },
      { text: 'Eye disease is treated separately and by degree, from lubricating drops and sunglasses for mild cases through to steroids, other medicines, radiotherapy or surgery when it is severe.', src: [SRC.btfEye, SRC.ataEye] },
    ],
  },
  {
    id: 'living-with-it',
    number: '06',
    title: 'What is it like to live with?',
    image: 'graves-support',
    imageAlt: 'Two pairs of hands resting together on cream linen.',
    paras: [
      { text: 'Treated properly, the outlook is generally good. The American Thyroid Association describes Graves’ disease as controllable, safely treated, and treatment almost always successful.', src: [SRC.cleveland, SRC.ata] },
      { text: 'It can come back. Relapse can happen at any stage after stopping medicine, and is most likely within six months of stopping.', src: [SRC.cuh] },
      { text: 'Monitoring becomes part of life. After tablets, occasional blood tests if things stay stable. After surgery or radioiodine, frequent tests until levels settle and then yearly ones, because of the long term chance of an underactive thyroid.', src: [SRC.btf, SRC.cuh] },
      { text: 'The mental side is real and it is documented. The British Thyroid Foundation describes feeling more emotional than before, mood that changes rapidly, anxiety, low mood and irritability. Most people improve as the thyroid is brought under control, though not always as fast as they hope, and some feel not quite right for a while even after the blood tests look normal.', src: [SRC.btfMind] },
      { text: 'Left untreated, an overactive thyroid raises the risk of an irregular heartbeat, heart failure, weakened bones and complications in pregnancy. There is also a rare emergency called thyroid storm, for which the NHS says to call 999.', src: [SRC.nhsComplications, SRC.niddk] },
    ],
  },
] as const;

/** Short sourced facts, set as a break between chapters. */
const facts = [
  { text: 'It is named after Robert James Graves, an Irish physician who described it about 150 years ago. In much of Europe the same condition is called Basedow’s disease.', src: SRC.ata },
  { text: 'The thyroid is shaped like a butterfly, which is why the butterfly became the symbol for thyroid conditions.', src: SRC.medline },
  { text: 'Thyroid hormones affect nearly every organ, including the way the heart beats. Untreated, Graves’ disease can lead to a rapid irregular heartbeat.', src: SRC.niddk },
  { text: 'Eye symptoms can appear around six months before the thyroid diagnosis, so the eyes are sometimes the first sign.', src: SRC.ata },
  { text: 'Smokers are up to eight times more likely to develop thyroid eye disease than non smokers.', src: SRC.btf },
  { text: 'About 4 in every 5 people with an overactive thyroid have Graves’ disease.', src: SRC.nhs },
  { text: 'Treating an overactive thyroid often leads to an underactive one. Almost everyone who has radioiodine later develops hypothyroidism.', src: SRC.niddk },
  { text: 'It can show on the skin. A rare sign makes the skin on the shins thick, reddish and rough.', src: SRC.niddk },
] as const;

/**
 * Real organisations, with details taken from their own pages. No number here
 * is inferred. Thyroid UK is deliberately not described as a helpline: their
 * own support page states they have no telephone Support Networkers.
 */
const support = [
  {
    name: 'British Thyroid Foundation',
    where: 'United Kingdom',
    body: 'A patient charity with written query and volunteer peer support from people who live with thyroid conditions.',
    detail: 'Office 01423 810093, 11am to 3pm on selected weekdays. Their own pages differ on which days, so check the site.',
    href: 'https://www.btf-thyroid.org/',
    note: 'Registered charity 1006391 in England and Wales, SC046037 in Scotland.',
  },
  {
    name: 'Thyroid UK',
    where: 'United Kingdom',
    body: 'Information, local groups and an online community. Their office line is an office line, not a helpline.',
    detail: 'Office 01255 820407, Monday to Friday 10am to 2pm. enquiries@thyroiduk.org',
    href: 'https://thyroiduk.org/',
    note: 'Registered charity 1125270.',
  },
  {
    name: 'Thyroid Eye Disease Charitable Trust',
    where: 'United Kingdom',
    body: 'Specifically for thyroid eye disease. Helpline, peer group, patient events and free membership.',
    detail: 'Helpline 07469 921 782. info@tedct.org.uk',
    href: 'https://tedct.org.uk/',
    note: '',
  },
  {
    name: "Graves' Disease and Thyroid Foundation",
    where: 'United States',
    body: 'Online support groups, patient bulletins and an annual conference. Founded in 1990.',
    detail: 'Toll free 1-877-643-3123 in the USA and Canada. info@gdatf.org',
    href: 'https://gdatf.org/',
    note: '',
  },
  {
    name: 'American Thyroid Association',
    where: 'United States',
    body: 'The professional body for thyroid medicine, with plain language patient pages and a tool for finding a specialist.',
    detail: 'Contact by form on their site.',
    href: 'https://www.thyroid.org/',
    note: '',
  },
] as const;

/*
 * NANI'S OWN WORDS. From the 15 September meeting, during which she was in a
 * flare and described it unprompted. Lightly tidied, nothing added.
 * Approved for publication by the client on 16 September 2026.
 */
const flare = {
  lines: [
    '“Right now you are watching me flare. If you look at my mannerisms, I am closing my eyes. My asthma is kicking in.',
    'I talk slower because I cannot get my brain to just get the thought out. You have to keep repeating yourself, because I am having processing problems. I cannot get my words out.',
    'You get short of breath. What you do not see are the shakes. I get tremors. They do not show on camera.',
    'I am having extreme nausea. My energy is just dwindling, like when someone has low blood pressure.',
    'I do not go to work because of this. I applied for disability, and I was denied.”',
  ],
  attribution: 'Nani Rosen, founder of The StillHer Foundation, describing a flare while in one.',
};

const reviewed = '16 September 2026';

const sourceList = Array.from(
  new Map(Object.values(SRC).map((s) => [s.name, s])).values()
) as Src[];
---

<Base title={article.title} description={article.description}>
  <article class="art">
    <!-- Masthead -->
    <header class="art__head">
      <div class="wrap wrap--narrow">
        <a class="art__back" href="/graves-disease">
          <span aria-hidden="true">&larr;</span> All resources
        </a>

        <ul class="art__tags" aria-label="Tags">
          {article.tags.map((tag) => <li class="art__tag">{tag}</li>)}
        </ul>

        <h1 class="art__title">{article.title}</h1>
        <p class="art__standfirst">{article.description}</p>

        <p class="art__meta">
          By The StillHer Foundation
          <span aria-hidden="true">&middot;</span>
          <time datetime={article.publishedISO}>{article.published}</time>
          <span aria-hidden="true">&middot;</span>
          {article.readingMinutes} min read
        </p>
      </div>
    </header>

    <!-- Lead image -->
    <div class="wrap art__lead">
      <Picture
        slot="graves-hero"
        alt="Morning light falling across a cream plaster wall above a linen armchair."
        ratio="16 / 9"
        loading="eager"
        sizes="(min-width: 64rem) 80rem, 100vw"
      />
    </div>

    <div class="wrap wrap--narrow art__body">
      <!-- Notice -->
      <aside class="art__notice" aria-labelledby="art-notice-h">
        <span class="label label--gold" id="art-notice-h">Please read first</span>
        <p>
          This article is general awareness information. It is not medical advice, and it is not
          a substitute for seeing a doctor. If you are worried about your health, or someone
          else's, please speak to a doctor. In the UK the NHS advises seeing a GP if you have
          symptoms of an overactive thyroid.
        </p>
        <p class="art__notice-meta">
          Every medical statement here is attributed to a named source and linked. We do not
          publish anything we cannot trace. Where authorities differ, we say so rather than
          picking one. Nothing here recommends a treatment.
        </p>
      </aside>

      <!-- Introduction -->
      <p class="art__lede">
        If you have just been told you have Graves' disease, or you are reading this because
        someone you love has, the first thing worth knowing is that it is common, it is
        treatable, and it is not the same thing as an overactive thyroid, even though the two
        get used interchangeably.
      </p>

      <p class="art__lede">
        The second thing worth knowing is what it actually feels like from the inside, which is
        the part the medical pages tend to leave out. So we are starting there.
      </p>

      <!-- Her words, straight after the introduction -->
      <section class="art__flare" aria-labelledby="flare-h">
        <span class="label">Start here</span>
        <h2 class="art__flare-title" id="flare-h">
          Here is what a flare actually looks like, in the founder's <span class="em">own words</span>
        </h2>
        <p class="art__flare-frame">
          Nani Rosen said this while it was happening to her. It is one woman's experience of one
          flare, not a description of the condition and not a checklist. Everything after it is
          sourced and cited.
        </p>

        <blockquote class="art__quote">
          {flare.lines.map((line) => <p>{line}</p>)}
        </blockquote>
        <p class="art__quote-attr">{flare.attribution}</p>

        <p class="art__flare-after">
          As Nani put it on the same call, it shows up differently in different bodies. If any of
          this sounds like you, or like someone you know, speak to a doctor.
        </p>
      </section>

      <!-- Contents -->
      <nav class="art__toc" aria-labelledby="toc-h">
        <h2 class="label" id="toc-h">In this article</h2>
        <ol>
          {
            sections.map((section) => (
              <li>
                <a href={`#${section.id}`}>
                  <span class="art__toc-n">{section.number}</span>
                  <span class="art__toc-t">{section.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <!-- Chapters -->
      {
        sections.map((section, i) => (
          <section class="art__chapter" id={section.id}>
            <p class="art__chapter-n">Chapter {section.number}</p>
            <h2 class="art__chapter-title">{section.title}</h2>

            {'intro' in section && section.intro && (
              <p class="art__intro">
                {section.intro}
                <cite class="art__cite">
                  {section.introSrc.map((s: Src, n: number) => (
                    <>
                      {n > 0 && ', '}
                      <a href={s.href} rel="noopener nofollow" target="_blank">{s.name}</a>
                    </>
                  ))}
                </cite>
              </p>
            )}

            {section.paras.map((para) => (
              <p class="art__para">
                {para.text}
                <cite class="art__cite">
                  {para.src.map((s: Src, n: number) => (
                    <>
                      {n > 0 && ', '}
                      <a href={s.href} rel="noopener nofollow" target="_blank">{s.name}</a>
                    </>
                  ))}
                </cite>
              </p>
            ))}

            {'callout' in section && section.callout && (
              <aside class="art__callout">
                <h3 class="art__callout-title">{section.callout.title}</h3>
                {section.callout.paras.map((para) => (
                  <p class="art__para">
                    {para.text}
                    <cite class="art__cite">
                      {para.src.map((s: Src, n: number) => (
                        <>
                          {n > 0 && ', '}
                          <a href={s.href} rel="noopener nofollow" target="_blank">{s.name}</a>
                        </>
                      ))}
                    </cite>
                  </p>
                ))}
              </aside>
            )}

            {/* The image sits between chapters, full column width, never beside the prose. */}
            {section.image && i < sections.length - 1 && (
              <figure class="art__figure">
                <Picture
                  slot={section.image}
                  alt={section.imageAlt}
                  ratio="16 / 9"
                  sizes="(min-width: 64rem) 46rem, 100vw"
                />
              </figure>
            )}
          </section>
        ))
      }

      <!-- Did you know -->
      <section class="art__facts" aria-labelledby="facts-h">
        <span class="label">Did you know</span>
        <h2 class="art__facts-title" id="facts-h">Eight things worth <span class="em">knowing</span></h2>
        <ol class="art__facts-list">
          {
            facts.map((fact) => (
              <li>
                <p class="art__para">
                  {fact.text}
                  <cite class="art__cite">
                    <a href={fact.src.href} rel="noopener nofollow" target="_blank">{fact.src.name}</a>
                  </cite>
                </p>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Support -->
      <section class="art__support" aria-labelledby="support-h">
        <span class="label">Go deeper</span>
        <h2 class="art__facts-title" id="support-h">Where to get <span class="em">support</span></h2>
        <p class="art__para">
          These are independent organisations, not partners of this foundation. Details are taken
          from their own pages. We are working on partnerships so there is somewhere trustworthy
          to send people, and we will say plainly when one is confirmed.
        </p>

        <ul class="art__orgs">
          {
            support.map((org) => (
              <li class="art__org">
                <span class="art__org-where">{org.where}</span>
                <h3 class="art__org-name">{org.name}</h3>
                <p>{org.body}</p>
                <p class="art__org-detail">{org.detail}</p>
                {org.note && <p class="art__org-note">{org.note}</p>}
                <a class="art__org-link" href={org.href} rel="noopener nofollow" target="_blank">
                  Visit {org.name}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Sources -->
      <section class="art__sources" aria-labelledby="sources-h">
        <h2 class="label" id="sources-h">Sources used in this article</h2>
        <ul class="art__source-list">
          {
            sourceList.map((s) => (
              <li>
                <a href={s.href} rel="noopener nofollow" target="_blank">{s.name}</a>
              </li>
            ))
          }
        </ul>
        <p class="art__sources-note">
          Every source in this article was fetched and read on {reviewed}. Medical guidance
          changes, so if you are reading this long after that date, follow the links to the
          source. Our full research notes, including the claims we chose not to publish and why,
          are kept with the site.
        </p>
      </section>

      <p class="art__footback">
        <a href="/graves-disease"><span aria-hidden="true">&larr;</span> Back to all resources</a>
      </p>
    </div>
  </article>

  <section class="section section--cream">
    <div class="wrap wrap--narrow">
      <Newsletter
        source="graves-article"
        heading="Know when the next one lands"
        blurb="We will write when a new article is published and when partner organisations are confirmed."
      />
    </div>
  </section>
</Base>

<style>
  /*
    One column, top to bottom. Prose is capped at a readable measure and
    centred; images break the full column width between chapters. Nothing sits
    beside the text, because that is what squeezed the previous version into a
    ribbon.
  */
  .art {
    padding-top: var(--space-xl);
  }

  /* ---------------- Masthead ---------------- */
  .art__back,
  .art__footback a {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    color: var(--teal-ink);
    text-decoration: none;
    margin-bottom: var(--space-l);
  }

  .art__back:hover,
  .art__footback a:hover {
    color: var(--ink);
  }

  .art__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin: 0 0 var(--space-m);
