---
import Base from '@/layouts/Base.astro';
import { giving } from '@/config/site';

/**
 * Her Road. Chapter two of Road to Her Smile.
 *
 * The six chapter medical journey ahead. Copy is the verbatim record of the
 * live campaign page in reference/MIGRATION.md, section 2.3.
 */
const card = giving.find((method) => method.id === 'card');
const cardHref = card?.detail.value ?? '';

const steps = [
  {
    kicker: 'Chapter one',
    title: 'The Journey to Texas',
    body: "Lia's surgical team is based in Texas, which means that every stage of her restoration requires travel from her home, a journey that is both physically demanding and financially significant for a woman living with the chronic fatigue and pain of Hashimoto's disease and fibromyalgia, conditions that turn even ordinary travel into an act of endurance.",
  },
  {
    kicker: 'Chapter two',
    title: 'The Initial Assessment',
    body: "The first step is a comprehensive oral examination to assess the full extent of bone loss in Lia's jaw and to determine whether active infection is present, a real and serious possibility given the nearly two decades of inadequate dental care and the compromised immune system that comes with her autoimmune conditions.",
  },
  {
    kicker: 'Chapter three',
    title: 'Best Case: Immediate Implants',
    body: "In the best possible outcome, the assessment reveals no active infection and sufficient bone density remaining in Lia's jaw to proceed directly to implant placement, allowing her to begin the restoration process in a single surgical visit and finally start the path toward being able to eat solid food and smile without pain.",
  },
  {
    kicker: 'Chapter four',
    title: 'Worst Case: Infection and Bone Grafting',
    body: "If the surgical team discovers active infection when they open Lia's jaw, they will have no choice but to close the surgical site, send her home to recover on antibiotics, and schedule a return trip to Texas for bone grafting, a separate procedure that involves rebuilding the deteriorated bone structure in her jaw and then waiting months for the graft to heal before implants can even be considered.",
  },
  {
    kicker: 'Chapter five',
    title: 'The Healing Process',
    body: "Even in the best-case scenario, the healing process following implant surgery is measured in months rather than weeks, and for a patient with Hashimoto's disease and fibromyalgia, the autoimmune complications could extend that timeline significantly, meaning any illness, infection, or flare-up during recovery could set the entire process back and require additional rounds of treatment.",
  },
  {
    kicker: 'Chapter six',
    title: 'The Road to Her Smile',
    body: 'This is the road. It is not simple, it is not guaranteed, and it is not short, but at the end of it, Lia Spriggs will be able to eat solid food without pain, speak clearly without the grinding discomfort of an ill-fitting denture, and smile without shame for the first time in nearly two decades, and every contribution to this project brings that moment closer to reality.',
  },
];
---

<Base
  title="Her Road"
  description="The medical journey ahead for Lia Spriggs, from assessment to implants to healing. Chapter two of Road to Her Smile, a StillHer Foundation documentary."
>
  <!-- Hero -->
  <section class="section hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <span class="label">Road to Her Smile. Chapter two</span>
        <h1>Her <span class="em">Road</span></h1>
        <p class="hero__sub">
          The medical journey ahead. What Lia faces on the road to getting her smile back.
        </p>
      </div>
      <div class="hero__media">
        <div class="ph-frame" style="--ph-ratio: 4 / 5">
          The road ahead<br />image to follow
        </div>
      </div>
    </div>
  </section>

  <!-- The road ahead -->
  <section class="section section--cream">
    <div class="wrap wrap--narrow">
      <span class="label">The road ahead</span>
      <h2>Six steps to her <span class="em">smile</span></h2>
      <ol class="road">
        {
          steps.map((step) => (
            <li class="road__step">
              <span class="road__kicker">{step.kicker}</span>
              <h3 class="road__title">{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- CTAs and chapter navigation -->
  <section class="section section--sand">
    <div class="wrap wrap--narrow">
      <span class="label">Every step matters</span>
      <h2>Bring that moment <span class="em">closer</span></h2>
      <p>
        Every contribution funds production, legal advocacy, and Lia's medical restoration. This
        is how we make sure her voice is finally heard.
      </p>
      <div class="ctas">
        {
          cardHref ? (
            <a href={cardHref} class="btn btn--primary" target="_blank" rel="noopener">
              Support Lia's Restoration
            </a>
          ) : (
            <span class="btn btn--primary" aria-disabled="true">
              Support Lia's Restoration
            </span>
          )
        }
        <a href="/road-to-her-smile#partnerships" class="btn btn--ghost">Become a sponsor</a>
      </div>

      <hr class="rule" />

      <nav class="chapter-nav" aria-label="Road to Her Smile chapters">
        <a class="chapter-nav__link" href="/road-to-her-smile/the-tragedy">
          <span class="chapter-nav__kicker">Previous chapter</span>
          <span class="chapter-nav__title"><span aria-hidden="true">&larr;</span> The Tragedy</span>
        </a>
        <a class="chapter-nav__link chapter-nav__link--next" href="/road-to-her-smile/who-is-lia">
          <span class="chapter-nav__kicker">Next chapter</span>
          <span class="chapter-nav__title">Who is Lia? <span aria-hidden="true">&rarr;</span></span>
        </a>
      </nav>
    </div>
  </section>
</Base>

<style>
  .hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-2xl);
    }
  }

  .hero__sub {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    line-height: 1.3;
    max-width: 32ch;
  }

  .hero__media .ph-frame {
    width: 100%;
  }

  /* A gold hairline runs down the timeline. */
  .road {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0 0 0 var(--space-l);
    position: relative;
  }

  .road::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    bottom: 0;
    width: 1px;
    background: var(--gold);
    opacity: 0.55;
  }

  .road__step {
    position: relative;
    padding-bottom: var(--space-xl);
  }

  .road__step:last-child {
    padding-bottom: 0;
  }

  .road__step::before {
    content: '';
    position: absolute;
    left: calc(var(--space-l) * -1 - 4px);
    top: 0.45em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--cream);
    border: 1px solid var(--gold);
  }

  .road__step:last-child::before {
    background: var(--teal);
    border-color: var(--teal-ink);
  }

  .road__kicker {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-widest);
    color: var(--gold-ink);
    margin-bottom: var(--space-2xs);
  }

  .road__title {
    font-size: var(--step-2);
    margin-bottom: var(--space-xs);
  }

  .road__step p {
    margin: 0;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .chapter-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-m);
  }

  .chapter-nav__link {
    text-decoration: none;
    color: var(--ink);
  }

  .chapter-nav__link--next {
    text-align: right;
    margin-left: auto;
  }

  .chapter-nav__kicker {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-widest);
    color: var(--gold-ink);
    margin-bottom: var(--space-3xs);
  }

  .chapter-nav__title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-2);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) var(--ease);
  }

  .chapter-nav__link:hover .chapter-nav__title {
    border-bottom-color: var(--gold);
  }
</style>
