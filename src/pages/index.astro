---
import Base from '@/layouts/Base.astro';
import HeroStage, { type HeroSlide } from '@/components/HeroStage.astro';
import InitiativePanels from '@/components/InitiativePanels.astro';
import Newsletter from '@/components/Newsletter.astro';
import Placeholder from '@/components/Placeholder.astro';
import { org, mission, impactStats } from '@/config/site';

/**
 * Three slides, set on the 15 September call.
 *
 * 1. The tagline over her portrait
 * 2. About us and what we do
 * 3. Protecting Her Ecosystem
 *
 * The old "The work, right now" slideshow is gone. Her words: "just get rid
 * of that, because it's repeating." The standalone Protecting Her Ecosystem
 * section is gone too, because it is slide 3 now.
 */
const slides: HeroSlide[] = [
  {
    id: 'tagline',
    kicker: org.name,
    headline: "I won't let <em>Graves</em> put me in one.",
    body: mission.statement,
    slot: 'hero-nani',
    focus: '70% 45%',
    imageAlt:
      'Nani Rosen seated in a sunlit Mediterranean room, smiling toward the camera.',
    framePrompt: '',
    cta: { label: 'Donate', href: '/support' },
    secondary: { label: 'About the foundation', href: '/about' },
  },
  {
    id: 'what-we-do',
    kicker: 'About us',
    headline: 'What the foundation <em>does</em>.',
    body: 'We raise awareness of Graves’ disease, we create a safe space for women in business, and we back the work that protects a woman’s ecosystem. Three commitments, one piece of work.',
    slot: 'hero-backplate',
    focus: '40% 50%',
    imageAlt: 'Light falling across linen and teal silk.',
    cta: { label: 'Read about us', href: '/about' },
    secondary: { label: 'About the founder', href: '/founder' },
  },
  {
    id: 'her-ecosystem',
    kicker: 'The initiative',
    headline: 'Protecting <em>Her</em> Ecosystem.',
    body: 'Taking care of ourselves is how we protect a woman’s ecosystem. It is the thinking that connects the documentary, the retreat, the speaking and the planning for her future.',
    slot: 'texture-teal-wash',
    focus: '50% 50%',
    imageAlt: 'A teal watercolour wash bleeding across cream paper.',
    cta: { label: 'Explore the initiative', href: '/her-ecosystem' },
  },
];
---

<Base title={org.name} unveil bare>
  <HeroStage slides={slides} footLabel="Our initiative" />

  <!-- Four ways we show up. Moved directly under the hero, per the meeting. -->
  <section class="section--panels">
    <div class="wrap">
      <header class="section__head section__head--centred">
        <span class="label">Our initiatives</span>
        <h2 class="section__title">Four ways we <span class="em">show up</span></h2>
      </header>
    </div>
    <InitiativePanels />
  </section>

  <!-- Impact -->
  <section class="section section--cream impact">
    <div class="wrap">
      <header class="section__head section__head--centred">
        <h2 class="label">Our impact</h2>
      </header>
      <ul class="impact__list">
        {
          impactStats.map((stat) => (
            <li class="impact__item">
              <span class="impact__value">
                <Placeholder field={stat.value} />
              </span>
              <span class="impact__label">{stat.label}</span>
            </li>
          ))
        }
      </ul>
      <p class="impact__note">
        We publish numbers only once they are verified. These will be filled in shortly.
      </p>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section">
    <div class="wrap wrap--narrow">
      <Newsletter
        source="home"
        heading="Keep up with our newsletter"
        blurb="Stories from the work, news from the campaigns, and guidance for women living with Graves&rsquo; disease."
      />
    </div>
  </section>
</Base>

<style>
  .section__head {
    margin-bottom: var(--space-xl);
  }

  .section__head--centred {
    text-align: center;
  }

  .section__title {
    font-size: var(--step-4);
    margin: 0;
  }

  .section--panels {
    padding-block: var(--space-2xl) 0;
  }

  .impact__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-l);
    text-align: center;
    border-block: 1px solid var(--gold);
    padding-block: var(--space-xl);
  }

  @media (min-width: 40rem) {
    .impact__list {
      grid-template-columns: repeat(3, 1fr);
    }

    .impact__item + .impact__item {
      border-left: 1px solid color-mix(in srgb, var(--gold) 50%, transparent);
    }
  }

  .impact__value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--teal-ink);
  }

  .impact__label {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-widest);
    color: var(--ink-soft);
    margin-top: var(--space-xs);
  }

  .impact__note {
    text-align: center;
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin: var(--space-m) auto 0;
  }
</style>
