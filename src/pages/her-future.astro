---
/**
 * Her Future. Planning for the future, presented only under the foundation.
 *
 * Five pillars since the 15 September meeting: Earned Income Opportunities
 * joined the four. Asset protection still lives inside Retirement &
 * Generational Wealth. The booking funnel is a popup (HerFutureFunnel), opened
 * from any [data-hf-open] button on this page. Nothing on this page asks a
 * visitor about money.
 */
import Base from '@/layouts/Base.astro';
import HerFutureFunnel from '@/components/HerFutureFunnel.astro';
import Picture from '@/components/Picture.astro';
import { herFuture } from '@/config/site';

const pillars = [
  {
    id: 'iul',
    number: '01',
    title: 'Indexed Universal Life (IUL)',
    body: 'What an IUL policy is, how it is structured, and whether it has a place in the plan for the people who depend on you.',
  },
  {
    id: 'business_insurance',
    number: '02',
    title: 'Business Insurance',
    body: 'Cover for the business you have built. If you already hold a policy, we will talk about whether it still fits.',
  },
  {
    id: 'annuities',
    number: '03',
    title: 'Annuities',
    body: 'What an annuity is, the kinds that exist, and the questions worth asking before you consider one.',
  },
  {
    id: 'retirement',
    number: '04',
    title: 'Retirement & Generational Wealth',
    body: 'Planning for the years after work and for what you pass on. Asset protection sits here too: keeping what you have built safe, for you and for the next generation.',
  },
  {
    id: 'earned_income',
    number: '05',
    title: 'Earned Income Opportunities',
    body: 'Ways to earn alongside what you already do. What is involved, what it asks of you, and the questions worth asking before you say yes to anything.',
  },
];

const CTA = 'Book a call. 20 minutes yours.';

const howItWorks = [
  {
    step: 'One',
    title: 'Choose a pillar',
    body: 'Pick one of the five, or choose Other and type it in. Just one.',
  },
  {
    step: 'Two',
    title: 'Tell us a little',
    body: 'A yes or no where it matters, a note if you would like to leave one, and your contact details.',
  },
  {
    step: 'Three',
    title: 'Book twenty minutes',
    body: 'A discovery call, uninterrupted. It is a conversation, not an application.',
  },
];
---

<Base
  title="Her Future"
  description="Autoimmune or not, a woman's future depends on her. Book a 20 minute discovery call to talk about IUL, business insurance, annuities, retirement, generational wealth or earned income opportunities."
>
  <!-- Hero -->
  <section class="section hf-hero">
    <div class="wrap">
      <div class="hf-hero__grid">
        <div class="hf-hero__copy">
          <span class="label">Her Future</span>
          <h1>Autoimmune or not, a woman's future depends on <span class="em">her</span>.</h1>
          <p class="hf-hero__lede">
            Whether or not you live with an autoimmune condition, you should be planning for your
            future. Her Future is the foundation's space for that conversation: quiet, unhurried, and
            on your terms.
          </p>
          <button type="button" class="btn btn--primary" data-hf-open>{CTA}</button>
          <p class="hf-hero__under">
            A discovery call to talk about your generational wealth planning. Not an application.
          </p>
        </div>

        <div class="hf-hero__media">
          <Picture
            slot="her-future-desk"
            alt="A leather notebook, a fountain pen and a folded teal cloth on a pale wooden desk in soft window light."
            ratio="4 / 3"
            focus="50% 60%"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="section section--cream" aria-labelledby="pillars-heading">
    <div class="wrap">
      <span class="label">Five pillars</span>
      <h2 id="pillars-heading">Where we can <span class="em">begin</span></h2>
      <p class="hf-pillars__lede">
        Every discovery call starts with one of these five, or with whatever else is on your mind.
        Choose the one that matters now; the rest can wait for another day.
      </p>

      <div class="grid grid--2 hf-pillars">
        {
          pillars.map((pillar) => (
            <article class="card hf-pillar" id={`pillar-${pillar.id}`}>
              <span class="hf-pillar__number" aria-hidden="true">
                {pillar.number}
              </span>
              <h3 class="card__title">{pillar.title}</h3>
              <p>{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section section--sand" aria-labelledby="how-heading">
    <div class="wrap">
      <span class="label">How it works</span>
      <h2 id="how-heading">Three short steps to a <span class="em">conversation</span></h2>

      <ol class="hf-how grid grid--3">
        {
          howItWorks.map((item) => (
            <li class="hf-how__item">
              <span class="hf-how__step">{item.step}</span>
              <h3 class="hf-how__title">{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>

      <p class="hf-how__note">
        We will never ask about your income, assets, net worth or account balances. We only need the
        answers on the form.
      </p>
    </div>
  </section>

  <!-- Funnel -->
  <HerFutureFunnel />

  <!-- CTA repeat -->
  <section class="section section--tight section--cream hf-repeat">
    <div class="wrap--narrow">
      <hr class="rule rule--short" />
      <p class="hf-repeat__line">Planning is an act of care. Start with twenty minutes.</p>
      <button type="button" class="btn btn--ghost" data-hf-open>{CTA}</button>
    </div>
  </section>

  <!-- Compliance -->
  <aside class="hf-compliance" aria-label="Important information">
    <div class="wrap--narrow">
      <p>{herFuture.compliance}</p>
    </div>
  </aside>
</Base>

<style>
  .hf-hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .hf-hero__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-2xl);
    }
  }

  .hf-hero__lede {
    font-size: var(--step-1);
    margin-bottom: var(--space-l);
  }

  .hf-hero__copy .btn {
    text-align: center;
    max-width: 100%;
    line-height: 1.3;
  }

  .hf-hero__under {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin: var(--space-s) 0 0;
  }

  .hf-hero__media :global(.pic img) {
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-lift);
  }

  .hf-pillars__lede {
    margin-bottom: var(--space-l);
  }

  .hf-pillar {
    position: relative;
    display: grid;
    align-content: start;
  }

  /* Five cards in a two column grid leaves one alone. Let it run full width. */
  @media (min-width: 48rem) {
    .hf-pillar:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  .hf-pillar__number {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--gold-ink);
    margin-bottom: var(--space-s);
  }

  .hf-how {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .hf-how__item {
    padding-top: var(--space-m);
    border-top: 1px solid var(--gold);
  }

  .hf-how__step {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-widest);
    color: var(--teal-ink);
    margin-bottom: var(--space-xs);
  }

  .hf-how__title {
    font-size: var(--step-2);
    margin-bottom: var(--space-xs);
  }

  .hf-how__note {
    margin-top: var(--space-xl);
    font-size: var(--step--1);
    color: var(--ink-soft);
    padding-left: var(--space-m);
    border-left: 1px solid var(--gold);
  }

  .hf-repeat {
    text-align: center;
  }

  .hf-repeat .rule--short {
    margin: 0 auto var(--space-l);
  }

  .hf-repeat__line {
    font-family: var(--font-display);
    font-size: var(--step-2);
    margin: 0 auto var(--space-m);
  }

  .hf-repeat .btn {
    text-align: center;
    line-height: 1.3;
  }

  /* Small, quiet, still AA: ink-soft on cream is above 6:1. */
  .hf-compliance {
    padding-block: var(--space-l) var(--space-xl);
    border-top: 1px solid color-mix(in srgb, var(--gold) 50%, transparent);
  }

  .hf-compliance p {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }
</style>
