---
import Base from '@/layouts/Base.astro';
import Tabs from '@/components/Tabs.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import Placeholder from '@/components/Placeholder.astro';
import { org, partnerships, isPlaceholder } from '@/config/site';

/**
 * Partnerships & Press. The standalone Partnership Opportunities page.
 *
 * Same two tab structure as the partnerships section on /road-to-her-smile,
 * with a fuller press brief. The story angles are the verbatim list from the
 * live press page, reference/MIGRATION.md section 2.7.
 */
const deckPending = isPlaceholder(partnerships.sponsorshipDeck);

const angles = [
  'The making of an independent documentary on a zero-to-one budget',
  'Black women in documentary filmmaking and media production',
  'Medical abandonment and institutional accountability in America',
  'How immigrant women navigate systems not designed for them',
  "A daughter telling her mother's story: the personal stakes of documentary work",
];
---

<Base
  title="Partnerships & Press"
  description="Sponsorship and press opportunities for Road to Her Smile, a StillHer Foundation documentary. Sponsor the film or bring the story to your audience."
>
  <!-- Hero and pitch -->
  <section class="section">
    <div class="wrap wrap--narrow">
      <span class="label">The StillHer Foundation</span>
      <h1>Partnerships <span class="em">&amp;</span> Press</h1>
      <p class="lede">
        Road to Her Smile is our first documentary, backed by the Protecting Her Ecosystem
        initiative. It cannot be made alone.
      </p>
      <p>
        Sponsors fund production, legal advocacy, and distribution, and are credited on screen.
        Press carries the story further than we ever could on our own. Their belief in this
        project makes every frame possible.
      </p>
      <div class="hero__ctas">
        <a href="#partnerships-page-panel-sponsorship" class="btn btn--primary">Sponsor the film</a>
        <a href="#partnerships-page-panel-press" class="btn btn--ghost">Cover the story</a>
        <a href="/road-to-her-smile" class="btn btn--gold">About the film</a>
      </div>
    </div>
  </section>

  <!-- Partnership Opportunities -->
  <section class="section section--cream" id="partnerships">
    <div class="wrap">
      <header class="section__head">
        <span class="label">Partner with the film</span>
        <h2>Partnership <span class="em">Opportunities</span></h2>
      </header>

      <Tabs
        id="partnerships-page"
        label="Partnership opportunities"
        tabs={[
          { id: 'sponsorship', label: 'Sponsorship' },
          { id: 'press', label: 'Press' },
        ]}
      >
        <div slot="sponsorship" class="panel">
          <h3>Sponsorship</h3>
          <p>
            The sponsorship deck covers the vision, the team, the budget, and how your
            contribution will be used. Every contribution funds production, post-production,
            legal advocacy, and distribution. Every dollar brings Lia closer to her smile.
          </p>
          <div class="deck">
            {
              deckPending ? (
                <>
                  <span class="btn btn--gold" aria-disabled="true">
                    Download the Sponsorship Deck (PDF)
                  </span>
                  <p class="deck__note">
                    <Placeholder
                      field={partnerships.sponsorshipDeck}
                      fallback="The deck is being finalised. Request it using the form below and we will send it when it is ready."
                    />
                  </p>
                </>
              ) : (
                <a
                  href={partnerships.sponsorshipDeck.value}
                  class="btn btn--gold"
                  download
                  type="application/pdf"
                >
                  Download the Sponsorship Deck (PDF)
                </a>
              )
            }
          </div>

          <hr class="rule" />

          <InquiryForm
            type="partnership"
            headingLevel="h4"
            heading="Become a sponsor"
            blurb="Tell us about you or your organization and we will come back with the deck and next steps."
            messageLabel="How would you like to be involved?"
            submitLabel="Send"
          />
        </div>

        <div slot="press" class="panel">
          <h3>Press</h3>
          <p>
            Road to Her Smile offers multiple entry points for press coverage. We welcome
            interview requests, features, and collaborative storytelling across the following
            angles:
          </p>
          <ul class="angles">
            {angles.map((angle) => <li>{angle}</li>)}
          </ul>

          <div class="press">
            <InquiryForm
              type="press_photo"
              headingLevel="h4"
              heading="Photography"
              blurb="Stills, portrait sessions and behind the scenes access."
              messageLabel="What are you looking to shoot?"
            />

            <hr class="rule" />

            <InquiryForm
              type="press_video"
              headingLevel="h4"
              heading="Videography"
              blurb="Broadcast, documentary crews and video features."
              messageLabel="What are you looking to film?"
            />

            <hr class="rule" />

            <InquiryForm
              type="press_news"
              headingLevel="h4"
              heading="News Outlet"
              blurb="Podcast, interview, editorial and other press."
              messageLabel="Tell us about your outlet and the story"
            />
          </div>
        </div>
      </Tabs>
    </div>
  </section>

  <!-- Direct contact -->
  <section class="section section--sand section--tight">
    <div class="wrap wrap--narrow">
      <span class="label">Prefer email?</span>
      <p class="contact">
        Write to <Placeholder field={org.email} />. We aim to respond within a few days.
      </p>
    </div>
  </section>
</Base>

<style>
  .lede {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-l);
  }

  .section__head {
    margin-bottom: var(--space-xl);
  }

  .panel h3 {
    margin-bottom: var(--space-xs);
  }

  .deck {
    margin-top: var(--space-m);
  }

  .deck__note {
    font-size: var(--step--1);
    margin: var(--space-s) 0 0;
  }

  .angles {
    margin: 0 0 var(--space-xl);
    padding-left: 1.2em;
    max-width: 68ch;
  }

  .angles li {
    margin-bottom: var(--space-2xs);
  }

  .angles li::marker {
    color: var(--gold-ink);
  }

  .press > .rule {
    margin: var(--space-xl) 0;
  }

  .contact {
    font-size: var(--step-0);
    margin: 0;
  }
</style>
