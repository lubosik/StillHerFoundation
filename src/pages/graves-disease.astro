---
/**
 * Graves' disease resource page. Route: /graves-disease.
 *
 * Nani framed it as "Graves, did you know". It is the most constrained page
 * on the site. Her words, 15 September: "when you have a nonprofit that is
 * made on helping people, you have to be careful, because yes we're raising
 * awareness, but we also have to make sure the information we're giving is
 * right."
 *
 * So this page invents nothing clinical. No prevalence, no symptom list, no
 * treatment, no cause, no statistic. Every medical block below is a designed
 * placeholder awaiting review by a named medical source. She is working on
 * partnering with other Graves' foundations; until one is confirmed the
 * partner section is a placeholder too.
 *
 * The only real content is Nani's own description of a flare, in her own
 * words, about her own body. It is presented as exactly that, not as
 * clinical information.
 *
 * The pending fields below are local to this page rather than in site.ts,
 * because site.ts is owned elsewhere. They use the same Pending shape so they
 * can be lifted into site.ts in one move. Noted in the hand back.
 */
import Base from '@/layouts/Base.astro';
import Placeholder from '@/components/Placeholder.astro';
import Newsletter from '@/components/Newsletter.astro';
import type { Pending } from '@/config/site';

const REVIEW_LINE =
  'This section is being written with, and reviewed by, a named medical source. It will be published once that review is complete.';

const pending = (note: string, fallback: string = REVIEW_LINE): Pending<string> => ({
  value: '',
  pending: true,
  fallback,
  note,
});

const blocks = [
  {
    id: 'what-it-is',
    number: '01',
    title: "What Graves' disease is",
    field: pending("Graves' resource page: what the condition is. Text from a named medical source."),
  },
  {
    id: 'how-it-shows-up',
    number: '02',
    title: 'How it shows up',
    field: pending("Graves' resource page: how the condition presents. Text from a named medical source."),
  },
  {
    id: 'getting-diagnosed',
    number: '03',
    title: 'Getting diagnosed',
    field: pending("Graves' resource page: diagnosis. Text from a named medical source."),
  },
  {
    id: 'living-with-it',
    number: '04',
    title: 'Living with it',
    field: pending("Graves' resource page: day to day management. Text from a named medical source."),
  },
  {
    id: 'support',
    number: '05',
    title: 'Where to get support',
    field: pending(
      "Graves' resource page: support organisations and lines. Confirmed partners only.",
      'Support organisations will be listed here once partnerships are confirmed. Until then, please speak to your doctor.'
    ),
  },
] as const;

const partnerSlots = [
  pending("Graves' partner organisation 1: name, logo and link.", 'Partner to be confirmed'),
  pending("Graves' partner organisation 2: name, logo and link.", 'Partner to be confirmed'),
  pending("Graves' partner organisation 3: name, logo and link.", 'Partner to be confirmed'),
];

/*
 * NANI'S OWN WORDS. Taken from the 15 September meeting, during which she was
 * in a flare and described it unprompted. Lightly tidied for the page, nothing
 * added. She has NOT yet approved this for publication. Confirm with her
 * before this page goes live, and take it down if she asks.
 */
const flare = {
  lines: [
    '“Right now you are watching me flare. If you look at my mannerisms, I am closing my eyes. My asthma is kicking in.',
    'I talk slower because I cannot get my brain to just get the thought out. You have to keep repeating yourself, because I am having processing problems. I cannot get my words out.',
    'You get short of breath. What you do not see are the shakes. I get tremors. They do not show on camera.',
    'I am having extreme nausea. My energy is just dwindling, like when someone has low blood pressure.',
    'I do not go to work because of this. I applied for disability, and I was denied.”'
  ],
  attribution: 'Nani Rosen, founder of The StillHer Foundation, describing a flare while in one.',
};
---

<Base
  title="Graves' Disease"
  description="Graves, did you know? A resource page from The StillHer Foundation for anyone who wants to understand Graves' disease. General awareness information, not medical advice."
>
  <!-- Hero -->
  <section class="section gd-hero">
    <div class="wrap">
      <div class="gd-hero__grid">
        <div class="gd-hero__copy">
          <span class="label">Graves' disease</span>
          <h1 class="gd-hero__title">Graves. Did you <span class="em">know</span>?</h1>
          <p class="gd-hero__lede">
            A resource page for the people living with Graves' disease, the people who love them,
            and the people who have only just heard the name.
          </p>
        </div>

        <aside class="gd-notice" aria-label="Important">
          <span class="label label--gold">Please read first</span>
          <p class="gd-notice__body">
            This page is general awareness information. It is not medical advice. If you are
            concerned about your health, or about someone else's, please speak to a doctor.
          </p>
          <p class="gd-notice__small">
            Every medical statement on this page is either attributed to a named medical source or
            is still awaiting one. We do not publish anything in between.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- Did you know, five blocks -->
  <section class="section section--white" aria-labelledby="dyk-heading">
    <div class="wrap">
      <header class="gd-head">
        <span class="label">Did you know</span>
        <h2 id="dyk-heading" class="gd-head__title">Five things worth <span class="em">knowing</span></h2>
        <p class="gd-head__lede">
          Each of these is being written with a recognised medical source and will be published once
          that source has reviewed it.
        </p>
      </header>

      <ol class="gd-blocks">
        {
          blocks.map((block) => (
            <li class="gd-block" id={block.id}>
              <span class="gd-block__number" aria-hidden="true">
                {block.number}
              </span>
              <div class="gd-block__body">
                <h3 class="gd-block__title">{block.title}</h3>
                <p class="gd-block__text">
                  <Placeholder field={block.field} />
                </p>
                <p class="gd-block__source">
                  <span class="gd-block__source-label">Source</span>
                  <span class="gd-block__source-value">Awaiting a named medical source</span>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Nani, in her own words -->
  <section class="section section--sand" aria-labelledby="flare-heading">
    <div class="wrap wrap--narrow">
      <span class="label">In her own words</span>
      <h2 id="flare-heading">What a flare actually <span class="em">looks</span> like</h2>
      <p class="gd-flare__frame">
        These are Nani's words about her own body, said while it was happening. They are one woman's
        experience of one flare. They are not a description of the condition, and they are not a
        checklist.
      </p>

      <blockquote class="gd-flare">
        {flare.lines.map((line) => <p>{line}</p>)}
        <footer class="gd-flare__cite">{flare.attribution}</footer>
      </blockquote>

      <p class="gd-flare__after">
        As Nani put it on the same call, it shows up differently in different bodies. If any of this
        sounds like you, or like someone you know, speak to a doctor.
      </p>
    </div>
  </section>

  <!-- Partner organisations, pending -->
  <section class="section" aria-labelledby="partners-heading">
    <div class="wrap">
      <header class="gd-head">
        <span class="label">Go deeper</span>
        <h2 id="partners-heading" class="gd-head__title">Partner <span class="em">organisations</span></h2>
        <p class="gd-head__lede">
          The foundation is working on partnerships with other Graves' disease organisations, so
          that anyone who wants to know more has somewhere trustworthy to go. They will be listed
          here once confirmed.
        </p>
      </header>

      <ul class="gd-partners">
        {
          partnerSlots.map((slot) => (
            <li class="gd-partner">
              <div class="ph-frame gd-partner__frame" style="--ph-ratio: 3 / 2">
                <Placeholder field={slot} />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Where this fits -->
  <section class="section section--cream">
    <div class="wrap gd-more">
      <div class="gd-more__item">
        <span class="label">Rest and company</span>
        <h3 class="gd-more__title">Her Relief Retreat</h3>
        <p>A retreat for women living with Graves' disease. Spa care, rest and community.</p>
        <a href="/her-relief-retreat" class="btn btn--ghost">About the retreat</a>
      </div>
      <div class="gd-more__item">
        <span class="label">The thinking</span>
        <h3 class="gd-more__title">Protecting Her Ecosystem</h3>
        <p>The ideology behind the work. Her body is her ecosystem, and looking after it is the point.</p>
        <a href="/her-ecosystem" class="btn btn--ghost">Read the initiative</a>
      </div>
      <div class="gd-more__item">
        <span class="label">The founder</span>
        <h3 class="gd-more__title">Nani Rosen</h3>
        <p>Why the foundation exists, from the woman who lives with the condition every day.</p>
        <a href="/founder" class="btn btn--ghost">About the founder</a>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section section--white">
    <div class="wrap wrap--narrow">
      <Newsletter
        source="graves-disease"
        heading="Be told when this page is complete"
        blurb="We will write once the reviewed sections and partner organisations are published."
      />
    </div>
  </section>
</Base>

<style>
  /* ---------------- Hero ---------------- */
  .gd-hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .gd-hero__grid {
      grid-template-columns: 1.3fr 0.9fr;
      gap: var(--space-2xl);
      align-items: end;
    }
  }

  .gd-hero__title {
    font-size: var(--step-5);
    line-height: 1.02;
    margin-bottom: var(--space-m);
  }

  .gd-hero__lede {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 44ch;
  }

  .gd-notice {
    background: var(--white);
    border: 1px solid var(--sand);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius-m);
    padding: var(--space-l);
    box-shadow: var(--shadow-soft);
  }

  .gd-notice__body {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.4;
    margin-bottom: var(--space-s);
  }

  .gd-notice__small {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin: 0;
  }

  /* ---------------- Section heads ---------------- */
  .gd-head {
    margin-bottom: var(--space-xl);
  }

  .gd-head__title {
    font-size: var(--step-4);
    margin-bottom: var(--space-s);
  }

  .gd-head__lede {
    max-width: 60ch;
    color: var(--ink-soft);
  }

  /* ---------------- Did you know blocks ---------------- */
  .gd-blocks {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--gold);
  }

  .gd-block {
    display: grid;
    gap: var(--space-s) var(--space-xl);
    padding-block: var(--space-l);
    border-bottom: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
  }

  @media (min-width: 48rem) {
    .gd-block {
      grid-template-columns: 6rem minmax(0, 1fr);
      padding-block: var(--space-xl);
    }
  }

  .gd-block__number {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-3);
    line-height: 1;
    color: var(--gold-ink);
  }

  .gd-block__title {
    font-size: var(--step-2);
    margin-bottom: var(--space-s);
  }

  .gd-block__text {
    max-width: 60ch;
  }

  .gd-block__source {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    align-items: baseline;
    margin: var(--space-s) 0 0;
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
  }

  .gd-block__source-label {
    color: var(--gold-ink);
  }

  .gd-block__source-value {
    color: var(--ink-soft);
  }

  /* ---------------- Flare, in her own words ---------------- */
  .gd-flare__frame {
    color: var(--ink-soft);
    margin-bottom: var(--space-l);
  }

  .gd-flare {
    margin: 0;
    padding-left: var(--space-l);
    border-left: 2px solid var(--gold);
  }

  .gd-flare p {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
    max-width: 30ch;
    margin-bottom: var(--space-m);
  }

  .gd-flare__cite {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    color: var(--ink-soft);
    margin-top: var(--space-l);
  }

  .gd-flare__after {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /* ---------------- Partners ---------------- */
  .gd-partners {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 48rem) {
    .gd-partners {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gd-partner__frame {
    width: 100%;
  }

  /* ---------------- Where this fits ---------------- */
  .gd-more {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 48rem) {
    .gd-more {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-l);
    }
  }

  .gd-more__item {
    display: grid;
    align-content: start;
    padding-top: var(--space-m);
    border-top: 1px solid var(--gold);
  }

  .gd-more__item .btn {
    justify-self: start;
  }

  .gd-more__title {
    font-size: var(--step-2);
    margin-bottom: var(--space-xs);
  }

  .gd-more__item p {
    color: var(--ink-soft);
    margin-bottom: var(--space-m);
  }
</style>
