---
/**
 * The site drawer.
 *
 * Opens from the left at every width, from the menu button in the top bar.
 * It replaces the old fixed desktop rail so that page content runs the full
 * width of the screen.
 *
 * Everything lives here and everything is visible at once. No nested
 * accordions, no truncation: the visitor opens the menu and sees the whole
 * site. On a wide screen the panel gets a second column so the list never
 * needs scrolling.
 */
import { railNav, railCta, topNav, org, mission } from '@/config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');

const initiatives = railNav.filter(
  (i): i is { label: string; href: string } => !('divider' in i)
);
/** The four initiatives come first, the rest are the ways to take part. */
const programmes = initiatives.slice(0, 4);
const involvement = initiatives.slice(4);
---

<div class="drawer-backdrop" data-drawer-backdrop hidden></div>

<nav id="site-drawer" class="drawer" aria-label="Site menu" data-drawer>
  <div class="drawer__inner">
    <div class="drawer__head">
      <a href="/" class="drawer__brand">
        <img src="/brand/emblem.svg" alt="" width="48" height="48" />
        <span class="drawer__brand-name">{org.name}</span>
      </a>

      <button type="button" class="drawer__close" data-drawer-close>
        <span class="visually-hidden">Close menu</span>
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <div class="drawer__cols">
      <section class="drawer__group">
        <h2 class="drawer__heading">Our initiatives</h2>
        <ul class="drawer__list">
          {
            programmes.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="drawer__link"
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="drawer__group">
        <h2 class="drawer__heading">Take part</h2>
        <ul class="drawer__list">
          {
            involvement.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="drawer__link"
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="drawer__group">
        <h2 class="drawer__heading">The foundation</h2>
        <ul class="drawer__list">
          {
            topNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="drawer__link"
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <div class="drawer__foot">
      <p class="drawer__mission">{mission.statement}</p>
      <a href={railCta.href} class="btn btn--primary drawer__cta">{railCta.label}</a>
    </div>
  </div>
</nav>

<style>
  .drawer {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 90;
    width: min(28rem, 92vw);
    background: var(--white);
    border-right: 1px solid var(--sand);
    transform: translateX(-101%);
    transition: transform var(--dur-base) var(--ease);
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: var(--shadow-lift);
  }

  /* Wide screens get a roomier panel and a two column list. */
  @media (min-width: 64rem) {
    .drawer {
      width: min(40rem, 60vw);
    }
  }

  .drawer[data-open='true'] {
    transform: translateX(0);
  }

  .drawer__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: var(--space-m) var(--space-l) var(--space-l);
    gap: var(--space-l);
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-bottom: var(--space-m);
    border-bottom: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
  }

  .drawer__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
    color: var(--ink);
  }

  .drawer__brand img {
    width: 2.75rem;
    height: auto;
  }

  .drawer__brand-name {
    font-family: var(--font-display);
    font-size: var(--step-0);
  }

  .drawer__close {
    background: none;
    border: 0;
    font-size: 2rem;
    line-height: 1;
    color: var(--ink);
    padding: 0.1rem 0.5rem;
  }

  .drawer__cols {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 64rem) {
    .drawer__cols {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-xl);
    }

    /* The foundation group sits under the shorter column. */
    .drawer__group:last-child {
      grid-column: 2;
    }
  }

  .drawer__heading {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--track-widest);
    color: var(--gold-ink);
    margin: 0 0 var(--space-s);
  }

  .drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .drawer__link {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.4em;
    border-bottom: 1px solid color-mix(in srgb, var(--sand) 55%, transparent);
    transition: color var(--dur-fast) var(--ease);
  }

  .drawer__link:hover,
  .drawer__link[aria-current='page'] {
    color: var(--teal-ink);
  }

  .drawer__link[aria-current='page'] {
    font-style: italic;
  }

  .drawer__foot {
    margin-top: auto;
    padding-top: var(--space-m);
    border-top: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
  }

  .drawer__mission {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-bottom: var(--space-m);
    max-width: 44ch;
  }

  .drawer__cta {
    width: 100%;
  }

  /* ---------------- Backdrop ---------------- */
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--ink) 45%, transparent);
    z-index: 80;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease);
  }

  .drawer-backdrop[data-open='true'] {
    opacity: 1;
  }
</style>

<script>
  // Drawer. Focus trapped while open, Escape closes, focus returns to the trigger.
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const backdrop = document.querySelector<HTMLElement>('[data-drawer-backdrop]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-drawer-close]');

  if (drawer && backdrop && openBtn && closeBtn) {
    const FOCUSABLE = 'a[href], button:not([disabled]), input, select, textarea';
    let lastFocused: HTMLElement | null = null;

    function open() {
      lastFocused = document.activeElement as HTMLElement;
      drawer!.dataset.open = 'true';
      backdrop!.hidden = false;
      // Next frame, so the transition actually runs.
      requestAnimationFrame(() => (backdrop!.dataset.open = 'true'));
      openBtn!.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      drawer!.querySelector<HTMLElement>(FOCUSABLE)?.focus();
    }

    function close() {
      delete drawer!.dataset.open;
      delete backdrop!.dataset.open;
      backdrop!.hidden = true;
      openBtn!.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      lastFocused?.focus();
    }

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (drawer.dataset.open !== 'true') return;

      if (e.key === 'Escape') {
        close();
        return;
      }

      if (e.key === 'Tab') {
        const items = Array.from(drawer.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
          (el) => el.offsetParent !== null
        );
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
