---
/**
 * The four tall vertical panels, taken from the L'Echelon category strip.
 *
 * Uppercase label, italic serif title, one line descriptor.
 * Panels stack on phones, run two up on tablets, four across on desktop.
 */
import { initiatives } from '@/config/site';
import Picture from './Picture.astro';

/** Per image crop, since the sources are 16:9 and the panels are tall. */
const FOCUS: Record<string, string> = {
  'rths-road': '50% 42%',
  'good-weekend-course': '52% 55%',
  'retreat-spa': '55% 50%',
  'her-future-desk': '50% 55%',
};
---

<section class="panels" aria-label="Our initiatives">
  {
    initiatives.map((item) => (
      <a class="panel" href={item.href}>
        <div class="panel__media">
          <Picture
            slot={item.image}
            alt=""
            ratio="3 / 4"
            focus={FOCUS[item.image] ?? '50% 50%'}
            sizes="(min-width: 68rem) 25vw, (min-width: 40rem) 50vw, 100vw"
          />
        </div>

        <div class="panel__body">
          <span class="panel__label">{item.label}</span>
          <h3 class="panel__title">
            {item.title.includes(item.emphasis) ? (
              <>
                {item.title.split(item.emphasis)[0]}
                <span class="em">{item.emphasis}</span>
                {item.title.split(item.emphasis)[1]}
              </>
            ) : (
              item.title
            )}
          </h3>
          <p class="panel__descriptor">{item.descriptor}</p>
          <span class="panel__more" aria-hidden="true">Explore</span>
        </div>
      </a>
    ))
  }
</section>

<style>
  .panels {
    display: grid;
    gap: 1px;
    background: color-mix(in srgb, var(--sand) 75%, transparent);
    border-block: 1px solid color-mix(in srgb, var(--sand) 75%, transparent);
  }

  @media (min-width: 40rem) {
    .panels {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .panels {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .panel {
    position: relative;
    display: block;
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    padding: 0;
    overflow: hidden;
    isolation: isolate;
  }

  .panel__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .panel__media :global(.pic),
  .panel__media :global(.pic img) {
    width: 100%;
    height: 100%;
  }

  .panel__media :global(.pic img) {
    aspect-ratio: auto;
    object-fit: cover;
  }

  /* A cream scrim so the copy keeps AA contrast over the photograph. */
  .panel__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--white) 0%,
      var(--white) 30%,
      color-mix(in srgb, var(--white) 86%, transparent) 46%,
      color-mix(in srgb, var(--white) 30%, transparent) 70%,
      transparent 100%
    );
  }

  /* A soft teal wash rises on hover. This is the whole interaction. */
  .panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--teal) 26%, transparent),
      transparent 55%
    );
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease);
  }

  .panel:hover::before,
  .panel:focus-visible::before {
    opacity: 1;
  }

  .panel__body {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(28rem, 68vh, 40rem);
    padding: var(--space-l);
  }

  .panel__label {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-widest);
    color: var(--teal-ink);
    margin-bottom: var(--space-xs);
  }

  .panel__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.05;
    margin: 0 0 var(--space-xs);
  }

  .panel__descriptor {
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--ink);
    margin: 0;
    max-width: 32ch;
  }

  .panel__more {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    color: var(--teal-ink);
    margin-top: var(--space-m);
    padding-bottom: 0.25em;
    border-bottom: 1px solid var(--gold);
    align-self: flex-start;
    transform: translateY(0.35rem);
    opacity: 0;
    transition:
      opacity var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }

  .panel:hover .panel__more,
  .panel:focus-visible .panel__more {
    opacity: 1;
    transform: translateY(0);
  }

  /* Touch devices get no hover, so show the affordance by default. */
  @media (hover: none) {
    .panel__more {
      opacity: 1;
      transform: none;
    }
  }
</style>
