---
/**
 * The four tall vertical panels, taken from the L'Echelon category strip.
 *
 * Uppercase label, italic serif title, one line descriptor.
 * Panels stack on phones, run two up on tablets, four across on desktop.
 */
import { initiatives } from '@/config/site';
---

<section class="panels" aria-label="Our initiatives">
  {
    initiatives.map((item) => (
      <a class="panel" href={item.href}>
        <div class="panel__media">
          <div class="ph-frame" style="--ph-ratio: 3 / 4" aria-hidden="true">
            {item.title}
          </div>
        </div>

        <div class="panel__body">
          <span class="panel__label">{item.label}</span>
          <h3 class="panel__title">
            {item.title.includes(item.emphasis) ? (
              <>
                {item.title.split(item.emphasis)[0]}
                <span class="em">{item.emphasis}</span>
                {item.title.split(item.emphasis)[1]}
              </>
            ) : (
              item.title
            )}
          </h3>
          <p class="panel__descriptor">{item.descriptor}</p>
          <span class="panel__more" aria-hidden="true">Explore</span>
        </div>
      </a>
    ))
  }
</section>

<style>
  .panels {
    display: grid;
    gap: 1px;
    background: var(--sand);
    border-block: 1px solid var(--sand);
  }

  @media (min-width: 40rem) {
    .panels {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .panels {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .panel {
    position: relative;
    display: block;
    background: var(--cream);
    color: var(--ink);
    text-decoration: none;
    padding: 0;
    overflow: hidden;
    isolation: isolate;
  }

  .panel__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .panel__media .ph-frame {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    border: 0;
    border-radius: 0;
    color: transparent;
  }

  .panel__media .ph-frame::after {
    display: none;
  }

  /* A soft teal wash rises on hover. This is the whole interaction. */
  .panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--teal) 30%, transparent),
      transparent 60%
    );
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease);
  }

  .panel:hover::before,
  .panel:focus-visible::before {
    opacity: 1;
  }

  .panel__body {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(20rem, 42vh, 30rem);
    padding: var(--space-l);
  }

  .panel__label {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-widest);
    color: var(--teal-ink);
    margin-bottom: var(--space-xs);
  }

  .panel__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.05;
    margin: 0 0 var(--space-2xs);
  }

  .panel__descriptor {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin: 0;
    max-width: 30ch;
  }

  .panel__more {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    color: var(--teal-ink);
    margin-top: var(--space-m);
    padding-bottom: 0.25em;
    border-bottom: 1px solid var(--gold);
    align-self: flex-start;
    transform: translateY(0.35rem);
    opacity: 0;
    transition:
      opacity var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }

  .panel:hover .panel__more,
  .panel:focus-visible .panel__more {
    opacity: 1;
    transform: translateY(0);
  }

  /* Touch devices get no hover, so show the affordance by default. */
  @media (hover: none) {
    .panel__more {
      opacity: 1;
      transform: none;
    }
  }
</style>
