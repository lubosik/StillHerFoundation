---
/**
 * Top bar.
 *
 * Menu button on the left, centred SHF emblem, Donate on the right.
 * The same at every width.
 *
 * The centred monogram with a split either side keeps the L'Echelon reference
 * that Nani asked for. Everything else moved into the drawer so that page
 * content gets the full width of the screen, which is how a charity site is
 * normally built and which the earlier fixed desktop rail was costing us.
 *
 * Donate stays permanently visible, because burying the primary action of a
 * fundraising site behind a menu is the one thing a hamburger must not do.
 */
import { org, railCta, topNav } from '@/config/site';

/**
 * Priority plus. These stay visible on desktop so the menu never has to be
 * opened to learn what the foundation does. Everything else is in the drawer.
 * The British Thyroid Foundation, Nani's own reference, uses exactly this
 * pattern: a hamburger paired with an always visible priority cluster.
 */
const priority = [
  { label: 'Road to Her Smile', href: '/road-to-her-smile' },
  { label: 'About Us', href: '/about' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="topbar">
  <div class="topbar__inner">
    <button
      type="button"
      class="topbar__menu"
      aria-expanded="false"
      aria-controls="site-drawer"
      data-drawer-open
    >
      <span class="topbar__burger" aria-hidden="true"></span>
      <span class="topbar__menu-label">Menu</span>
    </button>

    <a href="/" class="topbar__emblem" aria-label={`${org.name}, home`}>
      <img src="/brand/emblem.svg" alt="" width="56" height="56" />
    </a>

    <div class="topbar__end">
      <nav class="topbar__priority" aria-label="Primary">
        {
          priority.map((item) => (
            <a
              href={item.href}
              class="topbar__link"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <a href={railCta.href} class="btn btn--primary topbar__donate">{railCta.label}</a>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--white) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--sand) 70%, transparent);
  }

  .topbar__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-s);
    padding-inline: var(--gutter);
    padding-block: var(--space-2xs);
    min-height: 4.5rem;
  }

  /* ---------------- Menu button ---------------- */
  .topbar__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    justify-self: start;
    background: none;
    border: 0;
    padding: 0.7rem 0.25rem;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-widest);
  }

  .topbar__burger {
    position: relative;
    display: block;
    width: 1.4rem;
    height: 1px;
    background: currentColor;
  }

  .topbar__burger::before,
  .topbar__burger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 1.4rem;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease);
  }

  .topbar__burger::before {
    top: -6px;
  }

  .topbar__burger::after {
    top: 6px;
  }

  .topbar__menu:hover .topbar__burger::before {
    transform: translateY(-1px);
  }

  .topbar__menu:hover .topbar__burger::after {
    transform: translateY(1px);
  }

  /* The word "Menu" is a usability win on desktop, where a bare icon reads as
     ambiguous. It drops on phones, where the icon alone is understood. */
  .topbar__menu-label {
    display: none;
  }

  @media (min-width: 48rem) {
    .topbar__menu-label {
      display: inline;
    }
  }

  /* ---------------- Emblem ---------------- */
  .topbar__emblem {
    display: block;
    line-height: 0;
    grid-column: 2;
  }

  .topbar__emblem img {
    width: clamp(2.5rem, 4.5vw, 3.25rem);
    height: auto;
  }

  /* ---------------- Donate ---------------- */
  .topbar__end {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-m);
  }

  /* Hidden on narrow screens, where the drawer carries everything. */
  .topbar__priority {
    display: none;
    align-items: center;
    gap: var(--space-m);
  }

  @media (min-width: 64rem) {
    .topbar__priority {
      display: flex;
    }
  }

  .topbar__link {
    position: relative;
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.5em;
    white-space: nowrap;
  }

  .topbar__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15em;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease);
  }

  .topbar__link:hover::after,
  .topbar__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .topbar__donate {
    padding: 0.7em 1.5em;
  }

  @media (max-width: 29.999rem) {
    .topbar__donate {
      padding: 0.7em 1.1em;
      font-size: var(--step--2);
    }
  }
</style>
