---
/**
 * Top bar.
 *
 * Three things only: About Us, the centred SHF emblem, About the Founder.
 * This is a hard requirement from the Sep 14 meeting. Nothing else goes here.
 * No social icons, no donate button, no rail links.
 *
 * The split around a centred monogram mirrors the L'Echelon reference.
 */
import { topNav, org } from '@/config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="topbar">
  <div class="topbar__inner">
    <nav class="topbar__side topbar__side--start" aria-label="About">
      <a
        href={topNav[0].href}
        class="topbar__link"
        aria-current={isCurrent(topNav[0].href) ? 'page' : undefined}
      >
        {topNav[0].label}
      </a>
    </nav>

    <a href="/" class="topbar__emblem" aria-label={`${org.name}, home`}>
      <img src="/brand/emblem.svg" alt="" width="56" height="56" />
    </a>

    <nav class="topbar__side topbar__side--end" aria-label="Founder">
      <a
        href={topNav[1].href}
        class="topbar__link"
        aria-current={isCurrent(topNav[1].href) ? 'page' : undefined}
      >
        {topNav[1].label}
      </a>
    </nav>

    <button
      type="button"
      class="topbar__menu"
      aria-expanded="false"
      aria-controls="rail-drawer"
      data-drawer-open
    >
      <span class="visually-hidden">Open menu</span>
      <span class="topbar__burger" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--cream) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
  }

  .topbar__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-s);
    padding-inline: var(--gutter);
    padding-block: var(--space-2xs);
    min-height: 4.5rem;
  }

  .topbar__side {
    display: flex;
    align-items: center;
  }

  .topbar__side--end {
    justify-content: flex-end;
  }

  .topbar__link {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--track-widest);
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.5em;
    position: relative;
  }

  .topbar__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15em;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease);
  }

  .topbar__link:hover::after,
  .topbar__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .topbar__emblem {
    display: block;
    line-height: 0;
    grid-column: 2;
  }

  .topbar__emblem img {
    width: clamp(2.5rem, 5vw, 3.5rem);
    height: auto;
  }

  /* Menu button appears only where the fixed rail is hidden. */
  .topbar__menu {
    display: none;
    position: absolute;
    left: var(--gutter);
    background: none;
    border: 0;
    padding: 0.75rem 0.25rem;
  }

  .topbar__burger,
  .topbar__burger::before,
  .topbar__burger::after {
    display: block;
    width: 1.35rem;
    height: 1px;
    background: var(--ink);
    transition: transform var(--dur-fast) var(--ease);
  }

  .topbar__burger::before,
  .topbar__burger::after {
    content: '';
    position: relative;
  }

  .topbar__burger::before {
    top: -6px;
  }

  .topbar__burger::after {
    top: 5px;
  }

  @media (max-width: 63.999rem) {
    .topbar__inner {
      position: relative;
    }

    .topbar__menu {
      display: block;
    }

    /* The two About links move into the drawer on small screens. */
    .topbar__side {
      display: none;
    }

    .topbar__emblem {
      grid-column: 1 / -1;
      justify-self: center;
    }
  }
</style>
